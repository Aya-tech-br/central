# Copie este arquivo para .env (na mesma pasta) e preencha. O .env fica só na
# máquina que roda a automação e nunca vai para o Git.
#
#     cp .env.exemplo .env
#
# Se for hospedar, estas mesmas variáveis vão no painel da hospedagem, na área
# de variáveis de ambiente, uma por linha. Nenhuma delas entra em arquivo de
# código.


# ---------------------------------------------------------------------------
# 1. POR ONDE OS E-MAILS SAEM
# ---------------------------------------------------------------------------
# 'resend' (API) ou 'smtp' (Gmail/Workspace com senha de app).
EMAIL_CANAL=resend


# --- Opção A: API (recomendada quando o remetente é de domínio próprio) ------
# A chave é gerada no painel da Resend, em API Keys. É um texto que começa com
# re_ e funciona como a credencial do serviço: quem tem ela envia e-mail em nome
# do seu domínio. Não é senha de pessoa nenhuma, e ninguém digita ela em lugar
# algum: ela só fica aqui.
RESEND_API_KEY=re_sua_chave_aqui

# Quem aparece como remetente. O domínio precisa estar verificado na Resend,
# o que é feito publicando os registros de DNS que o painel indica.
EMAIL_REMETENTE=AYA Academy <no-reply@ayatech.co>


# --- Opção B: SMTP do Google (use se EMAIL_CANAL=smtp) ----------------------
# SMTP_SENHA NÃO é a senha da conta Google. É uma "senha de app": um código de
# 16 letras gerado em https://myaccount.google.com/apppasswords, que só existe
# para programas acessarem a conta. Exige verificação em duas etapas ativa.
# SMTP_USUARIO=conta-real@aya.tec.br
# SMTP_SENHA=abcd efgh ijkl mnop
# SMTP_HOST=smtp.gmail.com
# SMTP_PORTA=587
# Remetente diferente de quem autentica só funciona se o endereço estiver
# cadastrado como alias E em "Enviar e-mail como" no Gmail dessa conta.
# SMTP_REMETENTE=no-reply@aya.tec.br


# ---------------------------------------------------------------------------
# 2. ACESSO À INTERFACE WEB (só se for usar a tela no navegador)
# ---------------------------------------------------------------------------
# Quem pode entrar, no formato usuario:hash, separados por vírgula. O hash é
# gerado pelo comando abaixo, que pergunta a senha sem mostrá-la na tela:
#
#     mala-direta hash-senha
#
# A senha em si nunca é guardada em lugar nenhum: só o hash fica aqui. É essa
# senha que a pessoa digita na tela de login.
MALA_DIRETA_USUARIOS=veronica:$2b$12$coloque-o-hash-gerado-aqui

# Texto aleatório que o sistema usa para assinar o cookie de sessão e saber que
# ele não foi adulterado. Ninguém digita isso: é segredo do servidor. Gere com:
#
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
#
MALA_DIRETA_CHAVE_SECRETA=cole-aqui-o-texto-aleatorio-gerado
