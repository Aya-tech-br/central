# Copie para .env e preencha. O .env NUNCA vai para o Git.
# Gmail/Workspace: ative a verificação em duas etapas e gere uma senha de app em
# https://myaccount.google.com/apppasswords (16 caracteres, sem espaços).

SMTP_HOST=smtp.gmail.com
SMTP_PORTA=587
SMTP_USUARIO=seu.email@aya.tec.br
SMTP_SENHA=senha-de-app-de-16-caracteres
# Opcional: endereço que aparece como remetente, se diferente do usuário.
SMTP_REMETENTE=seu.email@aya.tec.br
SMTP_TLS=1
